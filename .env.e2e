# Límites relajados SOLO para las pruebas de extremo a extremo (npm run start:e2e). No contiene secretos.
# Una corrida completa hace miles de solicitudes desde la misma IP: con los límites de producción (600 cada 15 minutos) las páginas
# empiezan a recibir «429 Demasiadas solicitudes» a mitad de la corrida y las pruebas fallan sin que haya un error real.
# El límite del chat (15 por minuto) y el del proveedor de IA NO se tocan: protegen los tokens y las pruebas se espacian por eso.
RATE_LIMIT_API_MAX=100000
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_PUBLIC_MAX=1000
