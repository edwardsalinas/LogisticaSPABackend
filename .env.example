# ==================== Servidor ====================
PORT=3000
NODE_ENV=development

# ==================== Supabase (Auth + PostgreSQL) ====================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Clave pública (anon): la usa el login. Si se omite, el login usa la Service Role (no recomendado).
SUPABASE_ANON_KEY=

# ==================== Modelo de IA (Gemini de Google por defecto) ====================
# Clave de API: https://aistudio.google.com/apikey  (la suscripción Google AI Pro NO incluye cuota de API)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Opcional. Por defecto 'gemini-flash-lite-latest' (alias a la versión Flash-Lite vigente); fija un modelo concreto si lo prefieres.
# LLM_MODEL_NAME=gemini-flash-lite-latest
# Alternativas: LLM_PROVIDER=qwen (LLM_API_KEY) u openai (OPENAI_API_KEY). Otro endpoint compatible con OpenAI:
# LLM_BASE_URL=

# --- Varios modelos a la vez (balanceador) ---
# Reparte las consultas entre proveedores gratuitos y, si uno falla o se satura, responde otro. Solo se usan los que
# tienen clave. Sin LLM_POOL funciona solo con LLM_PROVIDER, como siempre.
# LLM_POOL=gemini,groq,cerebras,openrouter
# LLM_STRATEGY=balanced          # balanced: reparte por carga | speed: prefiere al más rápido
# LLM_TIMEOUT_MS=30000           # tiempo máximo por intento antes de pasar a otro modelo
# GROQ_API_KEY=                  # https://console.groq.com/keys
# CEREBRAS_API_KEY=              # https://cloud.cerebras.ai
# OPENROUTER_API_KEY=            # https://openrouter.ai/keys (modelos con sufijo :free)
# Modelo y límite por minuto de cada uno (los planes gratuitos cambian: verifícalos en el panel del proveedor):
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b   GROQ_RPM=30  GROQ_TPM=8000
# (Groq limita por MODELO: 8 000 tokens/min en el plan gratuito; cada modelo de la lista entra al pool por separado)
# CEREBRAS_MODELS=qwen-3.8-27b,gpt-oss-120b   (límites por modelo ya incluidos: qwen 450 rpm / 150 000 tpm; gpt-oss 5 rpm / 30 000 tpm)
# OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free   (respaldo: solo se usa si los demás no pueden)
# GEMINI_RPM=15

# ==================== Seguridad ====================
# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Cookies de sesión httpOnly
# COOKIE_SECURE=false          # true en producción con HTTPS (por defecto: true si NODE_ENV=production)
# COOKIE_SAMESITE=lax          # 'none' (+ HTTPS) si frontend y API están en sitios distintos
# COOKIE_DOMAIN=

# Roles: el rol confiable vive en app_metadata (solo escribible por el servidor).
# Mientras existan usuarios con el rol en user_metadata el respaldo sigue activo; tras ejecutar
# scripts/migrate-roles-to-app-metadata.js cámbialo a false para cerrar la escalada de privilegios.
AUTH_ALLOW_USER_METADATA_ROLE=true

# Detrás de un proxy/balanceador (nginx, Railway, Render): cantidad de proxies de confianza
# TRUST_PROXY=1

# CAPTCHA (Cloudflare Turnstile). Si se deja vacío, la verificación queda deshabilitada.
TURNSTILE_SECRET_KEY=
# Clave pública del widget: solo la usa docker-compose para construir el frontend
TURNSTILE_SITE_KEY=

# Rate limiting (valores por defecto entre paréntesis)
# RATE_LIMIT_API_MAX=600        # peticiones por IP cada 15 min a toda la API
# RATE_LIMIT_LOGIN_MAX=10       # intentos fallidos de login por IP cada 15 min
# RATE_LIMIT_PUBLIC_MAX=20      # consultas de rastreo público por IP por minuto
# RATE_LIMIT_CHAT_MAX=15        # mensajes al asistente de IA por IP por minuto

# Puerto del host para el frontend en docker compose (por defecto 8080)
# FRONTEND_PORT=8080
