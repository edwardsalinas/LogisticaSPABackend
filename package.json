{
  "name": "backend",
  "version": "1.0.0",
  "description": "Este repositorio contiene el código fuente del backend para el sistema de Gestión Logística Asistida por Inteligencia Artificial.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "start:e2e": "node --env-file=.env --env-file=.env.e2e src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "seed": "node --env-file=.env src/shared/utils/seed.js",
    "demo:sembrar": "node --env-file=.env scripts/seed-demo.mjs",
    "demo:quitar": "node --env-file=.env scripts/seed-demo.mjs --remove",
    "demo:preparar": "node --env-file=.env scripts/seed-demo.mjs --remove && node --env-file=.env scripts/seed-demo.mjs",
    "test:flow": "node --env-file=.env tests/integration/full-flow.test.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "ai:eval": "node --env-file=.env scripts/ai-eval.mjs",
    "ai:eval:docs": "node --env-file=.env scripts/ai-eval-docs.mjs",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@electric-sql/pglite": "^0.5.17",
    "husky": "^9.1.7",
    "supabase": "^3.2.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.34",
    "@langchain/google-genai": "^2.3.7",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/openai": "^1.3.0",
    "@supabase/supabase-js": "^2.99.2",
    "base64-js": "^1.5.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "langchain": "^1.2.35",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.3.6"
  }
}
